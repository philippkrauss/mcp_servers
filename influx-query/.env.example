# influx-query configuration
#
# Copy this file to .env in the same directory and fill it in.
# .env is git-ignored and must stay that way - it holds the token and is the
# only place where host names and paths live.
#
# Syntax: KEY=VALUE, one per line. Values are taken literally, so Windows
# paths need no escaping and no quotes. Comments must be on their own line.

# --- required ---------------------------------------------------------------

# Base URL of the InfluxDB 2.x HTTP API, without a path.
INFLUX_URL=https://influx.example.org

# Organisation name (not the ID).
INFLUX_ORG=myorg

# A READ-ONLY token. This is the actual safety boundary of the server, so do
# not reuse an operator or all-access token. Create one with:
#   influx auth create --org myorg --read-buckets --description "mcp influx-query (read-only)"
# influx_status warns if the token turns out to be broader than that.
INFLUX_TOKEN=

# --- exports ----------------------------------------------------------------

# Directory flux_export writes CSV files to. Created on first use if its
# parent exists; a missing parent (detached drive, sync client not running)
# is refused. Leave empty to disable the export tools.
# export_cleanup only ever deletes files matching the server's own naming
# pattern (YYYYMMDD-HHMMSS_name.csv / .flux) directly in this directory.
EXPORT_DIR=/home/user/data/influx-exports

# --- schema documentation -----------------------------------------------------

# Where the meaning of the data is documented: collector code, field
# references, dashboards with working queries. These paths are NOT read or
# served by this server. They are announced to the assistant in the server
# instructions, so it can look them up with its own file tools and always
# sees the current state instead of a copy.
# Format: label=path;label=path   (the label is optional)
#SCHEMA_SOURCES=Collector code=/home/user/src/collectors;Field reference=/home/user/notes/fields.md

# IANA time zone mentioned in the instructions for calendar-aligned windows.
#LOCAL_TIMEZONE=Europe/Berlin

# --- limits -----------------------------------------------------------------

# flux_query returns its result into the conversation. These limits protect
# the model's context, not the database: beyond them the output is cut and
# the total is still reported.
#CHAT_MAX_ROWS=1000
#CHAT_MAX_CHARS=60000
# After cutting, the rest of the response is still read to count rows - but
# no more than this many MB.
#CHAT_MAX_SCAN_MB=50
#QUERY_TIMEOUT=60

# flux_export streams into a file. These limits protect the database host and
# the local disk. Exceeding one aborts the export and keeps nothing.
#EXPORT_MAX_ROWS=2000000
#EXPORT_MAX_MB=200
#EXPORT_TIMEOUT=900

# --- query checks -----------------------------------------------------------

# Flux packages a query may import, in addition to the built-in allowlist
# (see DEFAULT_ALLOWED_IMPORTS in server.py). Packages that can reach the
# network, read secrets or write data are deliberately not on it.
# Comma-separated.
#EXTRA_ALLOWED_IMPORTS=csv
