# static-site-sync configuration
#
# Copy this file to .env in the same directory and fill it in.
# .env is git-ignored and must stay that way - it is the only place where
# host names and paths live.
#
# Syntax: KEY=VALUE, one per line. Values are taken literally, so Windows
# paths need no escaping and no quotes. Comments must be on their own line.

# --- required ---------------------------------------------------------------

# SSH destination. Either user@host or, preferably, an alias from your
# ssh config so that identity file, port and options stay out of this file.
SSH_HOST=webhost

# Directory whose contents get mirrored. Everything below it is considered,
# minus dotfiles and anything without an allowed suffix.
LOCAL_DIR=/home/user/projects/example-site/public

# Absolute path on the remote host. Files here that no longer exist locally
# are deleted, so this must be a directory the server owns exclusively.
# Refused if it is a top-level directory.
REMOTE_DIR=/srv/www/example/public

# --- optional ---------------------------------------------------------------

# Public URL. If set, site_status checks the HTTP response and, for https,
# how long the certificate is still valid.
#SITE_URL=https://example.org/

# If the site is served by a container, site_status reports whether it runs.
# Matched with: docker ps --filter name=<value>
#CONTAINER_NAME=example-web

# Staging directory on the remote host. Must be on the same filesystem as
# REMOTE_DIR and is removed after every run.
# Default: REMOTE_DIR with a .sync-staging suffix.
#REMOTE_STAGING_DIR=/srv/www/example/.staging

# A file that must be present and reasonably sized, or the sync is refused.
# This is what stops a detached network drive or a cloud-sync placeholder
# from emptying the live site. Set SENTINEL_FILE= (empty) to disable.
#SENTINEL_FILE=index.html
#SENTINEL_MIN_BYTES=500

# Comma-separated list of suffixes that may be transferred. Anything else in
# the source directory is ignored, which keeps notes, config and secrets out
# of the web root. Defaults to the usual static web assets.
#ALLOWED_SUFFIXES=.html,.css,.js,.svg,.png,.ico,.txt,.json,.woff2

# Size limits. Exceeding either one aborts before anything is transferred.
#MAX_FILE_MB=5
#MAX_TOTAL_MB=25

# Permissions applied to the remote directory after each sync. The default
# gives directories 755 and files 644, which is what a web server running as
# its own user needs in order to read them. Symbolic or octal.
#CHMOD_SPEC=u=rwX,go=rX

# Seconds before an SSH call is given up on.
#SSH_TIMEOUT=90
