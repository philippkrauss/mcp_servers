# ksuite-calendar - configuration
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Connection -------------------------------------------------------------

# CalDAV endpoint. For Infomaniak (kSuite / my kSuite) this is always the same.
CALDAV_URL=https://sync.infomaniak.com

# CalDAV user name of the account the server logs in as. For Infomaniak this is
# NOT the e-mail address but the short id shown on config.infomaniak.com
# (format AB12345).
CALDAV_USER=AB12345

# Application password of that account (required when 2FA is on).
# Use a dedicated account that only sees the calendars shared with it.
CALDAV_PASSWORD=

# --- Collections ------------------------------------------------------------
# Name=/server/path/ pairs, comma-separated. The names are what the tools use;
# the paths come from `python probe.py` (section 1, "Pfad"). Collections that
# are not listed here do not exist for the server.

# Calendars with events.
CALENDARS=Alltag=/calendars/AB12345/<uuid>/,Geburtstage=/calendars/AB12345/<uuid>/

# Task lists (reminders).
TASK_LISTS=Test=/calendars/AB12345/<uuid>/

# Calendars that are only ever read, e.g. public holidays.
READONLY=Feiertage=/calendars/AB12345/<uuid>/

# --- Writing ----------------------------------------------------------------

# Master switch for create_event, create_task, delete_event, delete_task.
ALLOW_WRITE=false

# Every write is appended here as one JSON line. Default: write.log next to
# server.py (git-ignored).
# WRITE_LOG=

# --- Optional ---------------------------------------------------------------

# Time zone for everything going in and out. Default Europe/Berlin.
# TIMEZONE=Europe/Berlin

# list_events without an end covers this many days. Default 14.
# DEFAULT_DAYS=14

# Longest range list_events accepts, in days. Default 366.
# MAX_RANGE_DAYS=366

# Most lines a list returns into the conversation. Default 300.
# MAX_RESULTS=300
